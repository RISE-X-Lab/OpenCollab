@startuml opencollab_module_map_v3
title OpenCollab - Module Dependency Map v3 (after Clean Architecture phase, Step12-15)

skinparam componentStyle rectangle
skinparam packageStyle rectangle
skinparam shadowing false
skinparam ArrowColor #555555
skinparam defaultFontName Helvetica

' ============================================================
' Layers (outermost first)
' ============================================================

package "UI / CLI drivers" as UI #LightBlue {
  [cli.main\n(Typer entry,\nREPL loop)] as CLIMain
  [cli.tui\n(Rich Live,\nSessionRuntimeEvent +\nTeamEvent rendering)] as TUI
  [tui.session_adapter\n(TuiEventSink,\nTuiPermissionPolicy)] as TuiAdapter
}

package "Composition root" as BOOT #AliceBlue {
  [bootstrap.runtime\n(RuntimeContext,\nbuild_runtime_context)] as Runtime
  [bootstrap.session_factory\n(build_chat_session,\nbuild_team)] as SessionFactory
  [bootstrap.container\n(SessionRuntime,\nbuild_session_runtime)] as Container
  [bootstrap.tool_factory\n(build_default_tools)] as ToolFactory
  [bootstrap.safety\n(build_workspace_safety_policy)] as BootSafety
}

package "Multi-agent orchestration" as TEAM #LightYellow {
  [team.orchestrator\n(Team, DelegateTaskTool,\nDelegateWithReviewTool)] as Team
  [team.teammate_factory\n(TeammateConfig,\nbuild_teammate_session)] as TeammateFactory
  [team.worktree_pool\n(WorktreePool)] as WorktreePool
  [team.prompts\n(lead + role prompts)] as TeamPrompts
}

package "Headless evaluator" as HARNESS #LightYellow {
  [harness.evaluator\n(EvalTask, EvalResult,\nrun_eval_task/batch)] as Eval
}

package "Adapters: core.session facades" as CORESESSION #LightGreen {
  [core.session.session\n(Session facade)] as Session
  [core.session.runner\n(SessionRunner facade)] as Runner
  [core.session.tools\n(ToolCallProcessor facade)] as ToolProc
  [core.session.compactor\n(ContextCompactor facade)] as Compactor
  [core.session.events\n(EventBus, EventSink,\nSessionEvent compat alias)] as Events
  [core.session.autosave\n(AutoSaveSubscriber)] as AutoSave
  [core.session.storage\n(SessionStore JSONL)] as Store
  [core.session.state\n(re-export of\ndomain.session)] as StateAlias
}

package "Adapters: infra + tools" as ADAPTERS #Pink {
  [core.agent\n(Agent dataclass)] as Agent
  [core.llm\n(LLMClient,\nprovider SDKs)] as LLM
  [core.env\n(Environment, Local,\nWorktree, Docker)] as Env
  [core.tracer\n(JSONL Tracer)] as Tracer
  [core.config\n(Pydantic config,\n.env loader)] as Config
  [core.context\n(get_repo_map)] as Context
  [tools.base\n(Tool, execute_with_runtime)] as ToolBase
  [tools.bash] as Bash
  [tools.fs\n(read/write/grep)] as FS
  [tools.safety\n(SandboxInterceptor)] as Safety
  [tools.human\n(AskUserTool)] as Human
  [tools.mcp] as MCP
}

package "Application: use cases + ports" as APP #LightCyan {
  [application.ports\n(EnvironmentPort, SafetyPolicyPort,\nPermissionPort, EventPublisherPort,\nLLMPort, SessionStorePort, TracePort,\nTokenEstimatorPort, RepoMapPort,\nWorktreePoolPort, ToolPort,\nSessionFactoryPort, TeammateSessionPort,\nSafetyPolicyFactory)] as Ports
  [application.events\n(SessionRuntimeEvent,\nTeamEvent)] as AppEvents
  [application.session_run\n(SessionRunUseCase,\nSessionRunEventFactory)] as SessionRun
  [application.tool_execution\n(ToolExecutionUseCase,\nToolExecutionEventFactory)] as ToolExec
  [application.compaction\n(ContextCompactionUseCase,\nCompactionEventFactory)] as Compaction
  [application.tool_dispatch\n(execute_tool_with_runtime)] as Dispatch
  [application.tool_runtime\n(ToolRuntime)] as RuntimeBundle
}

package "Domain: pure value types" as DOMAIN #PaleGreen {
  [domain.session\n(SessionState,\nSessionPhase)] as DomainSession
  [domain.compaction\n(CompactResult)] as DomainCompaction
  [domain.tools\n(ToolProcessingResult,\nMAX_CALL_HASH_WINDOW)] as DomainTools
}

' ============================================================
' Domain has no outward edges (Clean Architecture rule)
' ============================================================

' (no arrows from DOMAIN)

' ============================================================
' Application -> Application + Domain only
' (locked by tests/test_application_boundaries.py)
' ============================================================

SessionRun --> Ports          : LLMPort, EventPublisherPort,\nTracePort
SessionRun --> Compaction     : ContextCompactionUseCase
SessionRun --> ToolExec       : ToolExecutionUseCase
SessionRun --> DomainSession  : SessionState, SessionPhase

ToolExec --> Ports            : EventPublisherPort,\nPermissionPort,\nSafetyPolicyPort, TracePort
ToolExec --> Dispatch         : execute_tool_with_runtime
ToolExec --> RuntimeBundle    : ToolRuntime
ToolExec --> DomainSession
ToolExec --> DomainTools

Compaction --> Ports          : EventPublisherPort,\nLLMPort, TokenEstimatorPort,\nTracePort
Compaction --> DomainCompaction
Compaction --> DomainSession

Dispatch --> RuntimeBundle
RuntimeBundle --> Ports       : EnvironmentPort,\nPermissionPort,\nSafetyPolicyPort

AppEvents -[hidden]-> Ports

' ============================================================
' Adapters: core.session facades wrap application use cases
' (these are the deliberate inward references the facade pattern
'  requires; everything else in core.session is pure adapter glue)
' ============================================================

Runner --> SessionRun         : builds + delegates
Runner --> Events             : SessionEvent factory
Runner --> ToolProc           : facade unwraps\n_tool_execution
Runner --> Compactor          : facade unwraps\n_use_case
Runner --> DomainSession

Compactor --> Compaction      : wraps use case
Compactor --> LLM             : estimate_messages_tokens
Compactor --> Events
Compactor --> DomainCompaction
Compactor --> DomainSession

ToolProc --> ToolExec         : wraps use case
ToolProc --> Dispatch
ToolProc --> RuntimeBundle
ToolProc --> Ports            : SafetyPolicyPort
ToolProc --> Events
ToolProc --> DomainSession
ToolProc --> DomainTools

Events --> AppEvents          : re-exports\nSessionRuntimeEvent / TeamEvent

Session --> Runner
Session --> ToolProc
Session --> Compactor
Session --> Events
Session --> AutoSave
Session --> Store
Session --> Agent
Session --> Env
Session --> Tracer
Session --> Ports             : SafetyPolicyPort
Session --> DomainSession
Session ..> Container         : lazy default-factory\nimport in __init__

AutoSave --> Events           : implements EventSink
Store ..> DomainSession       : load/save messages
StateAlias --> DomainSession

' ============================================================
' Tools: depend only on application ports/runtime
' ============================================================

ToolBase --> RuntimeBundle    : execute_with_runtime\nsignature

ToolBase <|-- Bash
ToolBase <|-- FS
ToolBase <|-- Human
ToolBase <|-- MCP

Bash --> Ports                : EnvironmentPort,\nSafetyPolicyPort
FS   --> Ports                : EnvironmentPort,\nSafetyPolicyPort
Human --> Ports
MCP  --> Ports

Agent --> ToolBase            : owns Tool instances

' Team delegation tools are Tool subclasses defined in team.orchestrator
ToolBase <|-- Team            : DelegateTaskTool /\nDelegateWithReviewTool

' ============================================================
' Composition root: only layer allowed to know both
' application use cases AND concrete adapters
' ============================================================

Container --> Ports           : LLMPort, PermissionPort,\nSafetyPolicyPort,\nSessionStorePort, TracePort
Container --> Agent
Container --> Env             : LocalEnvironment
Container --> LLM             : LLMClient default
Container --> Events          : EventBus
Container --> AutoSave
Container --> Store
Container --> Runner
Container --> ToolProc
Container --> Compactor
Container --> DomainSession   : SessionState

Runtime --> Context           : get_repo_map
Runtime --> Tracer            : optional --trace
Runtime --> Events            : EventSink type
Runtime --> ToolProc          : PermissionPolicy type

SessionFactory --> Runtime
SessionFactory --> ToolFactory
SessionFactory --> BootSafety
SessionFactory --> Agent
SessionFactory --> Env        : LocalEnvironment
SessionFactory --> Session    : create / load
SessionFactory --> Team       : team mode
SessionFactory --> Human      : interactive tool

ToolFactory --> ToolBase
ToolFactory --> Bash
ToolFactory --> FS
ToolFactory --> Human

BootSafety --> Ports          : SafetyPolicyPort
BootSafety --> Safety         : SandboxInterceptor

' ============================================================
' Multi-agent layer: depends on application contracts +
' core.session compatibility re-exports
' ============================================================

Team --> AppEvents            : TeamEvent
Team --> Ports                : SafetyPolicyFactory,\nSessionFactoryPort
Team --> RuntimeBundle        : ToolRuntime
Team --> Agent
Team --> Events               : EventBus, EventSink,\nPermissionPolicy
Team --> Env
Team --> Tracer
Team --> Bash
Team --> FS
Team --> TeamPrompts
Team --> TeammateFactory
Team --> WorktreePool

TeammateFactory --> Ports     : SafetyPolicyFactory
TeammateFactory --> Agent
TeammateFactory --> Env
TeammateFactory --> Events    : EventBus, PermissionPolicy
TeammateFactory --> Session   : builds teammate Session
TeammateFactory --> Tracer
TeammateFactory --> Bash
TeammateFactory --> FS
TeammateFactory --> TeamPrompts

WorktreePool --> Env

' ============================================================
' Harness: depends on adapters (acceptable, headless eval driver)
' ============================================================

Eval --> Agent
Eval --> Session
Eval --> Env
Eval --> Tracer
Eval --> Bash
Eval --> FS

' ============================================================
' Drivers: CLI + TUI
' ============================================================

CLIMain --> Config
CLIMain --> TUI
CLIMain --> TuiAdapter
CLIMain --> Runtime
CLIMain --> SessionFactory
CLIMain --> Eval

TUI --> AppEvents             : consumes\nSessionRuntimeEvent +\nTeamEvent

TuiAdapter --> AppEvents      : translates events
TuiAdapter --> Events         : EventSink
TuiAdapter --> ToolProc       : PermissionPolicy type
TuiAdapter ..> TUI            : forwards / suspends render

' ============================================================
' Hotspot notes — what changed since v2
' ============================================================

note right of APP
  NEW in v3: full application layer.
  Use cases (SessionRunUseCase,
  ToolExecutionUseCase,
  ContextCompactionUseCase) own
  business logic. Ports define
  the contracts adapters fulfill.
  Boundary test
  test_application_boundaries.py
  forbids inward imports from
  core/tools/bootstrap/cli/tui/team.
end note

note right of DOMAIN
  NEW in v3: pure value objects.
  Zero outward edges.
  SessionState, SessionPhase,
  CompactResult, ToolProcessingResult
  moved out of core.session.
end note

note right of CORESESSION
  v3: core.session became
  thin adapter/facade glue.
  Runner, ToolProc, Compactor
  wrap their application use cases.
  Events re-exports SessionRuntimeEvent
  as the legacy SessionEvent alias.
  state.py is just a re-export
  of domain.session.
end note

note right of Container
  NEW in v3 (Step13): the composition
  root. Owns construction order for
  EventBus, SessionState, LLMClient,
  SessionStore, AutoSaveSubscriber,
  ToolProc, Compactor, Runner.
  Session(__init__) delegates here.
end note

note right of Team
  v3: delegation lifecycle now emits
  application.events.TeamEvent
  (no more SessionEvent overloading).
  Delegate tools implement
  execute_with_runtime (Step14 hotfix
  in Step15).
end note

note right of TUI
  v3: TUI consumes the split event
  contracts directly from
  application.events. Internal
  session vocabulary leaks no further
  than the EventSink type re-export.
end note

note bottom of ToolBase
  v3 (Step14): the legacy
  Tool.execute(env=, interceptor=,
  confirm_fn=) bridge is gone.
  Tools implement only
  execute_with_runtime(params, runtime).
end note

@enduml
