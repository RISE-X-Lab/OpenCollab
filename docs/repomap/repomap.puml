@startuml opencollab_repomap_current
title OpenCollab - Current Clean Architecture Dependency Map (2026-05-22)

skinparam componentStyle rectangle
skinparam packageStyle rectangle
skinparam shadowing false
skinparam ArrowColor #555555
skinparam defaultFontName Helvetica

' ============================================================
' Snapshot of the actual repo. Remaining differences from
' the target model are intentional and tracked:
'   * adapters.llm is one LLMClient (not split OpenAI/Anthropic).
'   * adapters.env keeps a separate WorktreePool adapter rather
'     than folding worktree lifecycle into the env adapter.
'   * app.session keeps a single Session facade rather than the
'     RunSession/AddUserMessage/SnapshotSession split.
' Closed since the prior snapshot:
'   * Agent 0 is now born inside the Scheduler. New
'     Scheduler.create_init_process(LaunchSpec) builds the
'     lead via SessionFactoryPort.create_lead_session and
'     applies the launch spec; register_lead is the
'     registration primitive it delegates to. The container
'     no longer assembles + registers the lead or splices its
'     spawn tools -- it only wires deps and passes a LaunchSpec
'     (session_file + auto_save_path). LaunchSpec lives in
'     app.scheduler; Session.apply_launch (idempotent
'     resume/seed) owns the persistence detail.
'   * app.role_prompts deleted. LEAD_SYSTEM_PROMPT, the role
'     prompts, and get_role_prompt were inlined into
'     bootstrap.container, its only consumer.
'   * The three per-use-case event factories
'     (SessionRunEventFactory / ToolExecutionEventFactory /
'     CompactionEventFactory) collapsed into one
'     app.events.SessionEventFactory. Duplicated
'     "compaction_applied" definition gone.
'   * app.tool_dispatch and app.tool_runtime both deleted.
'     The 1-line dispatch indirection is inlined into
'     ToolExecutionUseCase; ToolRuntime now lives in
'     app.tool_execution and every importer points there.
'   * app.team_prompts -> app.role_prompts. Teammate/Team
'     vocabulary in bootstrap renamed: TeammateConfig ->
'     SpawnConfig, build_teammate_session -> build_spawn_session,
'     SessionFactoryPort.build_teammate_session ->
'     build_spawn_session.
' ============================================================

package "Frameworks / Drivers\n(no project policy)" as DRIVERS #FADBD8 {
  [Typer + prompt_toolkit + Rich] as DriverCLI
  [OpenAI / Anthropic SDK] as DriverLLM
  [OS shell / filesystem] as DriverOS
  [git worktree] as DriverGit
  [JSONL files] as DriverStore
  [asyncio] as DriverAsync
}

package "Interface Adapters" as ADAPTERS #FDEBD0 {
  [adapters.cli.main\ndefault agent + eval commands] as CliAdapter
  [adapters.tui\nTUI\nTuiEventSink\nTuiPermissionPolicy] as TuiAdapter
  [adapters.llm\nLLMClient\nestimate_messages_tokens] as LLMAdapter
  [adapters.env\nLocalEnvironment\nWorktreeEnvironment] as EnvAdapter
  [adapters.worktree_pool\nWorktreePool] as WorktreeAdapter
  [adapters.storage\nSessionStore] as StoreAdapter
  [adapters.trace\nTracer] as TraceAdapter
  [adapters.safety\nSandboxInterceptor] as SafetyAdapter
  [adapters.tools\nBash / FileRead / FileWrite / Grep\nAskUser / Spawn] as ToolAdapters
}

package "Composition Root\n(bootstrap, 2 files)" as COMPOSITION #EBF5FB {
  [bootstrap.container\nbuild_runtime_context\nbuild_session_runtime\nbuild_session / snapshot_session / load_session\nbuild_scheduler\nbuild_spawn_session\nDefaultSessionFactory (build_spawn_session +\ncreate_lead_session) + SpawnConfig\nbuild_default_tools\nbuild_workspace_safety_policy] as Container
  [bootstrap.config\nload config + env] as Config
}

package "Application Layer\n(use cases + ports)" as APP #D5F5E3 {
  [app.session\nSession + SessionRuntime\napply_launch (idempotent resume/seed)] as SessionFacade
  [app.session_run\nSessionRunUseCase] as SessionRunner
  [app.compaction\nContextCompactionUseCase] as Compactor
  [app.tool_execution\nToolExecutionUseCase + ToolRuntime\nCallbackPermissionPolicy] as ToolExec
  [app.scheduler\nScheduler\ncreate_init_process (agent 0) + spawn (children),\nparallel via asyncio.create_task\nLaunchSpec] as SchedulerUC
  [app.autosave\nAutoSaveSubscriber] as Autosave
  [app.event_bus\nEventBus (fan-out)] as EventBus
  [app.events\nSessionEventFactory\n(one builder, all run-loop events)] as EventsModule

  interface "LLMPort" as LLMPort
  interface "EnvironmentPort" as EnvPort
  interface "SessionStorePort" as StorePort
  interface "TracePort" as TracePort
  interface "EventPublisherPort" as EventPort
  interface "PermissionPort" as PermissionPort
  interface "SafetyPolicyPort" as SafetyPort
  interface "WorktreePoolPort" as WorktreePort
  interface "ToolPort" as ToolPort
  interface "SessionFactoryPort" as SessionFactoryPort
  interface "SchedulerPort" as SchedulerPort
}

package "Domain Layer\n(policy + state, no I/O)" as DOMAIN #ABEBC6 {
  [domain.session\nSessionState (aid)\nSessionPhase (+ SCHEDULED)] as SessionDomain
  [domain.agent\nAgent] as AgentDomain
  [domain.tools\nToolSpec\nToolProcessingResult\nLoopDetection] as ToolDomain
  [domain.scheduler\nProcessTable / SessionControlBlock\nDelegationTask / ReviewVerdict / split_budget] as SchedulerDomain
  [domain.compaction\nCompactResult] as CompactionDomain
  [domain.events\nDomainEvent\nSessionRuntimeEvent\nSchedulerEvent] as DomainEvents
}

' ============================================================
' Drivers (outermost ring)
' ============================================================
CliAdapter --> DriverCLI
TuiAdapter --> DriverCLI
LLMAdapter --> DriverLLM
EnvAdapter --> DriverOS
WorktreeAdapter --> DriverGit
StoreAdapter --> DriverStore
TraceAdapter --> DriverStore
ToolAdapters --> DriverOS
SchedulerUC --> DriverAsync

' ============================================================
' Adapters implement application-owned ports
' ============================================================
LLMAdapter ..|> LLMPort
EnvAdapter ..|> EnvPort
StoreAdapter ..|> StorePort
TraceAdapter ..|> TracePort
TuiAdapter ..|> EventPort
TuiAdapter ..|> PermissionPort
SafetyAdapter ..|> SafetyPort
WorktreeAdapter ..|> WorktreePort
ToolAdapters ..|> ToolPort
SchedulerUC ..|> SchedulerPort

' ============================================================
' Composition Root wiring (only place that knows concretes)
' ============================================================
Container --> Config
Container --> LLMAdapter
Container --> EnvAdapter
Container --> StoreAdapter
Container --> WorktreeAdapter
Container --> TraceAdapter
Container --> SafetyAdapter
Container --> ToolAdapters
Container --> SessionFacade
Container --> SchedulerUC

CliAdapter --> Container : invokes build_scheduler

' ============================================================
' Application internal wiring
' ============================================================
SessionFacade --> SessionRunner
SessionFacade --> ToolExec
SessionFacade --> Compactor
SessionFacade --> EventBus
SessionFacade --> Autosave
SessionFacade --> StorePort
SessionFacade --> SessionDomain
SessionFacade --> AgentDomain

EventBus ..|> EventPort

SessionRunner --> EventPort
SessionRunner --> ToolExec
SessionRunner --> Compactor
SessionRunner --> LLMPort
SessionRunner --> TracePort
SessionRunner --> SessionDomain
SessionRunner --> EventsModule
SessionRunner --> DomainEvents

Compactor --> EventPort
Compactor --> LLMPort
Compactor --> TracePort
Compactor --> CompactionDomain
Compactor --> SessionDomain
Compactor --> EventsModule
Compactor --> DomainEvents

ToolExec --> EventPort
ToolExec --> ToolPort
ToolExec --> EnvPort
ToolExec --> PermissionPort
ToolExec --> SafetyPort
ToolExec --> TracePort
ToolExec --> AgentDomain
ToolExec --> ToolDomain
ToolExec --> SessionDomain
ToolExec --> EventsModule
ToolExec --> DomainEvents

EventsModule --> DomainEvents

SchedulerUC --> EventBus
SchedulerUC --> WorktreePort
SchedulerUC --> SessionFactoryPort
SchedulerUC --> TracePort
SchedulerUC --> SchedulerDomain
SchedulerUC --> SessionDomain
SchedulerUC --> DomainEvents

Autosave --> EventPort
Autosave --> StorePort
Autosave --> DomainEvents

' Spawn tools drive the scheduler via the port
ToolAdapters --> SchedulerPort

' ============================================================
' Domain internal relationships
' ============================================================
AgentDomain --> ToolDomain : declares ToolSpec
SchedulerDomain --> AgentDomain : SCB holds Agent
SchedulerDomain --> SessionDomain : SCB holds SessionState
SessionDomain --> DomainEvents
ToolDomain --> DomainEvents
CompactionDomain --> SessionDomain
  
' ============================================================
' Notes
' ============================================================
note right of APP
  Use cases own orchestration directly.
  SessionRunUseCase, ContextCompactionUseCase,
  and ToolExecutionUseCase are the only run-loop /
  compaction / tool-execution types. Scheduler owns
  all Session processes: agent 0 (aid=0) created via
  create_init_process (the OS-style init process) plus
  children spawned by spawn(), all in parallel via
  asyncio.create_task and tracked in a ProcessTable of
  SessionControlBlocks. Both build through
  SessionFactoryPort, so the scheduler never imports
  Session or knows env/tool/prompt/store detail.
end note

note right of COMPOSITION
  2 bootstrap files: container + config.
  bootstrap.container is the single composition
  root. build_scheduler() wires deps and hands the
  Scheduler a LaunchSpec; the Scheduler builds agent 0
  through DefaultSessionFactory.create_lead_session
  (lead env + spawn tools + prompt). build_session()
  is the free factory returning application.session.Session;
  snapshot_session and load_session are sibling functions.
  SpawnConfig + build_spawn_session wire sessions for
  agents the scheduler spawns at runtime.
end note

note bottom of EventPort
  EventPublisherPort is the single publish surface.
  TuiEventSink, EventBus, and AutoSaveSubscriber all
  implement it. Every event carries an aid so the TUI
  can route, filter, and group per-agent output.
  app.events.SessionEventFactory is the one place
  every run-loop / tool / compaction event is built.
end note

note right of DOMAIN
  No imports from app / adapters /
  bootstrap / SDKs / filesystem.
  domain.scheduler carries ProcessTable +
  SessionControlBlock (aid / parent_aid / agent / state)
  plus DelegationTask and ReviewVerdict; domain.tools
  carries LoopDetection.
end note

@enduml
