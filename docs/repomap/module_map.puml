@startuml opencollab_module_map
title OpenCollab — Module Dependency Map (opencollab/opencollab)

skinparam componentStyle rectangle
skinparam packageStyle rectangle
skinparam shadowing false
skinparam ArrowColor #555555
skinparam defaultFontName Helvetica

' ============================================================
' Layers
' ============================================================

package "UI / CLI layer" as UI #LightBlue {
  [cli.main\n(Typer entry, REPL,\norchestrates chat/team/eval)] as CLIMain
  [cli.tui\n(Rich Live, event_handler,\ntimeline + spinners)] as TUI
  [tui.session_adapter\n(TuiEventSink,\nTuiPermissionPolicy)] as TuiAdapter
}

package "Multi-agent layer" as TEAM #LightYellow {
  [team.orchestrator\n(Team, DelegateTaskTool,\nDelegateWithReviewTool)] as Team
  [team.prompts\n(LEAD_SYSTEM_PROMPT,\nrole prompts)] as TeamPrompts
}

package "Headless evaluator" as HARNESS #LightYellow {
  [harness.evaluator\n(EvalTask, EvalResult,\nrun_eval_task/batch)] as Eval
}

package "Core domain — Session runtime" as CORESESSION #LightGreen {
  [core.session.session\n(Session facade)] as Session
  [core.session.runner\n(SessionRunner,\nphase state machine)] as Runner
  [core.session.state\n(SessionState,\nSessionPhase)] as State
  [core.session.tools\n(ToolCallProcessor,\nPermissionPolicy,\nloop detection)] as ToolProc
  [core.session.compactor\n(ContextCompactor)] as Compactor
  [core.session.events\n(EventBus, EventSink,\nSessionEvent)] as Events
  [core.session.storage\n(SessionStore JSONL)] as Store
}

package "Core domain — config" as COREDOMAIN #LightGreen {
  [core.agent\n(Agent dataclass —\nstateless config)] as Agent
}

package "Adapters / Infra" as INFRA #Pink {
  [core.llm\n(LLMClient, OpenAI &\nAnthropic SDK wrapper)] as LLM
  [core.env\n(Environment, Local,\nWorktree, Docker)] as Env
  [core.tracer\n(JSONL Tracer)] as Tracer
  [core.config\n(Pydantic config,\n.env loader)] as Config
  [core.context\n(get_repo_map)] as Context
}

package "Tools (adapters around Env)" as TOOLS #Pink {
  [tools.base\n(Tool base)] as ToolBase
  [tools.bash] as Bash
  [tools.fs\n(read/write/grep)] as FS
  [tools.safety\n(SandboxInterceptor)] as Safety
  [tools.human\n(AskUserTool)] as Human
  [tools.mcp] as MCP
}

' ============================================================
' Entry-flow edges
' ============================================================
CLIMain --> Config       : load defaults
CLIMain --> Context      : get_repo_map
CLIMain --> TUI          : print / Live
CLIMain --> TuiAdapter   : wraps TUI
CLIMain --> Tracer       : optional --trace
CLIMain --> Agent        : build agent
CLIMain --> Env          : LocalEnvironment
CLIMain --> Safety       : SandboxInterceptor
CLIMain --> Bash
CLIMain --> FS
CLIMain --> Human
CLIMain --> Session      : create / load / run_loop
CLIMain --> Team         : team mode
CLIMain --> Eval         : eval mode

' Adapter wiring
TuiAdapter --> Events    : implements EventSink
TuiAdapter ..> TUI       : forwards events

' Team
Team --> Agent
Team --> Session         : spawn isolated sessions
Team --> Env             : LocalEnvironment / WorktreeEnvironment
Team --> Safety
Team --> Bash
Team --> FS
Team --> TeamPrompts
Team --> Events

' Harness
Eval --> Agent
Eval --> Session
Eval --> Env             : DockerEnvironment / LocalEnvironment
Eval --> Tracer
Eval --> Safety
Eval --> Bash
Eval --> FS

' Session internals
Session --> Runner
Session --> State
Session --> ToolProc
Session --> Compactor
Session --> Events
Session --> Store
Session --> Agent
Session --> Env
Session --> LLM          : LLMClient (lazy import via session.__init__)
Session --> Tracer

Runner --> State
Runner --> ToolProc
Runner --> Compactor
Runner --> Events
Runner --> LLM
Runner --> Tracer

ToolProc --> State
ToolProc --> Events
ToolProc --> Agent       : Agent.find_tool / tool_schemas
ToolProc --> Env         : tool.execute(env=...)
ToolProc --> Tracer

Compactor --> State
Compactor --> Events
Compactor --> LLM
Compactor --> Tracer

Store ..> State           : load/save messages

' Tool adapters
ToolBase <|-- Bash
ToolBase <|-- FS
ToolBase <|-- Human
ToolBase <|-- MCP
Bash --> Safety
Bash --> Env
FS --> Safety
FS --> Env

' Agent owns Tool instances
Agent --> ToolBase

' Team delegation tools are also Tools
ToolBase <|-- Team       : DelegateTaskTool /\nDelegateWithReviewTool

' ============================================================
' Notes about hot spots
' ============================================================
note right of CLIMain
  Imports nearly every layer:
  CLI, TUI, adapter, core, tools, team, harness.
  Holds business wiring for all 3 modes.
end note

note right of Session
  Public facade. Holds: agent, env, tracer,
  state, runner, compactor, tool_processor,
  event_bus, store, llm, permissions.
  Owns auto_save side-effect.
end note

note right of Team
  Imports Session internals AND
  builds tool sets AND
  manages worktree lifecycle.
end note

note right of TUI
  TUI keeps a class-level
  _active_instance singleton
  shared with CLIMain's confirm flow.
end note

@enduml
