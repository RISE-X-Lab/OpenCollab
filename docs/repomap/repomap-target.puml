@startuml opencollab_repomap_target
title OpenCollab - Target Clean Architecture Dependency Map

skinparam componentStyle rectangle
skinparam packageStyle rectangle
skinparam shadowing false
skinparam ArrowColor #555555
skinparam defaultFontName Helvetica

' ============================================================
' Clean Architecture rule:
' Source code dependencies point inward.
' Outer adapters implement application-owned ports.
' Domain does not import application, adapters, tools, UI, SDKs, or filesystem.
' ============================================================

package "Frameworks / Drivers\n(no project policy)" as DRIVERS #FADBD8 {
  [Typer / prompt_toolkit] as DriverCLI
  [Rich terminal] as DriverRich
  [OpenAI / Anthropic SDKs] as DriverLLM
  [OS shell / filesystem] as DriverOS
  [Docker / git worktree] as DriverEnv
  [JSONL files] as DriverStore
  [MCP servers] as DriverMCP
}

package "Interface Adapters\n(translate external shape to ports)" as ADAPTERS #FDEBD0 {
  [adapters.cli\ncommand parser + REPL adapter] as CliAdapter
  [adapters.tui\nSessionEventView\nTeamEventView\nPermissionPrompt] as TuiAdapter
  [adapters.llm\nOpenAIAdapter\nAnthropicAdapter] as LLMAdapter
  [adapters.env\nLocalEnvAdapter\nDockerEnvAdapter\nWorktreeEnvAdapter] as EnvAdapter
  [adapters.storage\nJsonlSessionStore] as StoreAdapter
  [adapters.trace\nJsonlTraceSink] as TraceAdapter
  [adapters.repo_map\nRepoMapProvider] as RepoMapAdapter
  [adapters.safety\nSandboxPolicyAdapter] as SafetyAdapter
  [adapters.tools\nBashToolAdapter\nFsToolAdapter\nHumanToolAdapter\nMcpToolAdapter] as ToolAdapters
}

package "Composition Root\n(wiring only)" as COMPOSITION #EBF5FB {
  [bootstrap.container\nbuild_runtime()\nbuild_session_app()\nbuild_team_app()] as Container
  [bootstrap.config\nload config + env vars] as Config
}

package "Application Layer\n(use cases + ports)" as APP #D5F5E3 {
  [app.session\nRunSession\nAddUserMessage\nSnapshotSession] as SessionUseCases
  [app.session_runner\nSessionStateMachine] as SessionStateMachine
  [app.context\nCompactContext] as ContextUseCase
  [app.tools\nExecuteToolCalls\nToolRegistry] as ToolUseCase
  [app.team\nRunTeam\nDelegateTask\nReviewLoop] as TeamUseCases

  interface "LLMPort" as LLMPort
  interface "EnvironmentPort" as EnvPort
  interface "SessionStorePort" as StorePort
  interface "TracePort" as TracePort
  interface "EventPublisherPort" as EventPort
  interface "PermissionPort" as PermissionPort
  interface "SafetyPolicyPort" as SafetyPort
  interface "RepoMapPort" as RepoMapPort
  interface "WorktreePoolPort" as WorktreePort
  interface "ToolPort" as ToolPort
}

package "Domain Layer\n(policy + state, no I/O)" as DOMAIN #ABEBC6 {
  [domain.session\nSessionState\nMessage\nSessionPhase\nTokenBudget] as SessionDomain
  [domain.agent\nAgentProfile\nToolSpec] as AgentDomain
  [domain.tool\nToolCall\nToolResult\nLoopDetection] as ToolDomain
  [domain.team\nTeamPlan\nDelegationTask\nReviewVerdict] as TeamDomain
  [domain.events\nSessionEvent\nTeamEvent\nDomainEvent] as DomainEvents
}

' ============================================================
' Outer drivers to adapters
' ============================================================

CliAdapter --> DriverCLI
TuiAdapter --> DriverRich
LLMAdapter --> DriverLLM
EnvAdapter --> DriverOS
EnvAdapter --> DriverEnv
StoreAdapter --> DriverStore
TraceAdapter --> DriverStore
ToolAdapters --> DriverOS
ToolAdapters --> DriverMCP

' ============================================================
' Composition root wires concrete adapters to use cases.
' No domain policy lives here.
' ============================================================

Container --> Config
Container --> CliAdapter
Container --> TuiAdapter
Container --> LLMAdapter
Container --> EnvAdapter
Container --> StoreAdapter
Container --> TraceAdapter
Container --> RepoMapAdapter
Container --> SafetyAdapter
Container --> ToolAdapters
Container --> SessionUseCases
Container --> TeamUseCases

' ============================================================
' Adapters implement application-owned ports.
' ============================================================

LLMAdapter ..|> LLMPort
EnvAdapter ..|> EnvPort
StoreAdapter ..|> StorePort
TraceAdapter ..|> TracePort
TuiAdapter ..|> EventPort
TuiAdapter ..|> PermissionPort
RepoMapAdapter ..|> RepoMapPort
SafetyAdapter ..|> SafetyPort
EnvAdapter ..|> WorktreePort
ToolAdapters ..|> ToolPort

CliAdapter --> SessionUseCases : invokes chat use cases
CliAdapter --> TeamUseCases : invokes team use cases

' ============================================================
' Application owns orchestration and depends only on domain + ports.
' ============================================================

SessionUseCases --> SessionStateMachine
SessionUseCases --> SessionDomain
SessionUseCases --> AgentDomain
SessionUseCases --> StorePort
SessionUseCases --> EventPort
SessionUseCases --> TracePort
SessionUseCases --> RepoMapPort

SessionStateMachine --> SessionDomain
SessionStateMachine --> ToolUseCase
SessionStateMachine --> ContextUseCase
SessionStateMachine --> LLMPort
SessionStateMachine --> EventPort
SessionStateMachine --> TracePort

ContextUseCase --> SessionDomain
ContextUseCase --> LLMPort
ContextUseCase --> EventPort
ContextUseCase --> TracePort

ToolUseCase --> AgentDomain
ToolUseCase --> ToolDomain
ToolUseCase --> ToolPort
ToolUseCase --> EnvPort
ToolUseCase --> PermissionPort
ToolUseCase --> SafetyPort
ToolUseCase --> EventPort
ToolUseCase --> TracePort

TeamUseCases --> TeamDomain
TeamUseCases --> AgentDomain
TeamUseCases --> SessionUseCases
TeamUseCases --> WorktreePort
TeamUseCases --> EventPort
TeamUseCases --> TracePort

' Domain relationships stay inside the domain layer.
AgentDomain --> ToolDomain : declares ToolSpec
TeamDomain --> AgentDomain : delegates to role profiles
SessionDomain --> DomainEvents : emits domain facts
ToolDomain --> DomainEvents : loop / tool facts
TeamDomain --> DomainEvents : delegation facts

' ============================================================
' Boundary notes
' ============================================================

note right of DOMAIN
  Target rule:
  domain has no imports from
  app, adapters, tools, SDKs,
  terminal UI, filesystem, or Docker.
end note

note right of APP
  Application owns ports.
  Use cases coordinate policy and
  depend on abstract capabilities,
  not concrete adapters.
end note

note right of ADAPTERS
  Adapters translate:
  SDK response -> LLMPort,
  Rich UI -> EventPublisherPort,
  shell/files -> EnvironmentPort,
  tools -> ToolPort.
end note

note right of COMPOSITION
  Only this layer knows all concrete
  implementations. It may import
  everything, but it should not
  contain business rules.
end note

note bottom of EventPort
  Split event contracts:
  SessionEvent for session runtime,
  TeamEvent for orchestration,
  UI events derived by adapters.
end note

note bottom of ToolPort
  Tools should not receive concrete
  SandboxInterceptor or terminal hooks.
  They receive EnvironmentPort,
  PermissionPort, and SafetyPolicyPort.
end note

@enduml
