# OpenCollab runtime configuration.
# Copy this file to configs/.env and fill in local secrets.

# OpenAI-compatible provider path, including DashScope compatible mode.
OPENCOLLAB_PROVIDER=openai
OPENCOLLAB_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
OPENCOLLAB_MODEL=glm-5.1
OPENCOLLAB_API_KEY=
# DashScope-compatible mode also accepts DASHSCOPE_API_KEY and prefers it for
# DashScope base URLs.
# DASHSCOPE_API_KEY=
# Optional token budget.
OPENCOLLAB_BUDGET=200000
# LLM sampling temperature (0.0 = lowest temperature). A team file may override this
# per role via `temperature:`.
OPENCOLLAB_TEMPERATURE=0.2
# Provider request timeout in seconds. Raise this for slow compatible models.
OPENCOLLAB_LLM_TIMEOUT=600
# Consume chat completions as a stream. OFF by default. Some endpoints return
# reasoning through streamed deltas, which the trajectory records. Turning it
# on adds "stream" and "stream_options" to the request. Thinking continuations
# and models that require reasoning_content keep it in outbound chat history.
# See configs/README.md for protocol, timeout, retry, and usage settings.
# OPENCOLLAB_LLM_STREAM_CHAT=true
# Thinking is opt-in. Parameters use the selected provider's request format.
# OPENCOLLAB_THINKING=true
# OpenAI-compatible example
# OPENCOLLAB_THINKING_PARAMS={"enable_thinking":true}
# Anthropic manual-thinking example. budget_tokens must be smaller than
# OPENCOLLAB_MAX_OUTPUT_TOKENS.
# OPENCOLLAB_MAX_OUTPUT_TOKENS=32768
# OPENCOLLAB_THINKING_PARAMS={"thinking":{"type":"enabled","budget_tokens":16000}}
# Deprecated compatibility setting. The TUI now retains every agent separately,
# starts on Lead (agent 0), and switches complete agent histories with Tab/Shift+Tab.
OPENCOLLAB_FILTER_MESSAGES=false
