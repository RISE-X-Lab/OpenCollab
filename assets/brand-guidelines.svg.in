<svg xmlns="http://www.w3.org/2000/svg" width="1254" height="1254" viewBox="0 0 1254 1254" role="img" aria-labelledby="title desc">
  <title id="title">OpenCollab brand guidelines</title>
  <desc id="desc">Editable vector recreation of the OpenCollab logo and visual identity board.</desc>
  <defs>
    <linearGradient id="brandGrad" x1="0" y1="0" x2="1" y2="0">
      <stop offset="0" stop-color="#7C3AED"/>
      <stop offset="1" stop-color="#2563EB"/>
    </linearGradient>
    <linearGradient id="colorBar" gradientUnits="userSpaceOnUse" x1="70" y1="0" x2="449" y2="0">
      <stop offset="0" stop-color="#7C3AED"/>
      <stop offset="1" stop-color="#2563EB"/>
    </linearGradient>
    <linearGradient id="footerBar" gradientUnits="userSpaceOnUse" x1="96" y1="0" x2="1138" y2="0">
      <stop offset="0" stop-color="#7C3AED"/>
      <stop offset="1" stop-color="#2563EB"/>
    </linearGradient>
    <filter id="shadow" x="-30%" y="-30%" width="160%" height="180%">
      <feDropShadow dx="0" dy="5" stdDeviation="7" flood-color="#0F172A" flood-opacity=".10"/>
    </filter>
    <!-- Each node cuts a circular notch out of the constant-width ring. -->
    <mask id="arcCutMask" maskUnits="userSpaceOnUse" x="-80" y="-80" width="160" height="160">
      <rect x="-80" y="-80" width="160" height="160" fill="#FFFFFF"/>
      <circle cx="0" cy="-52" r="20" fill="#000000"/>
      <circle cx="49" cy="-17" r="20" fill="#000000"/>
      <circle cx="30" cy="43" r="20" fill="#000000"/>
      <circle cx="-30" cy="43" r="20" fill="#000000"/>
      <circle cx="-49" cy="-17" r="20" fill="#000000"/>
    </mask>

    <g id="mark">
      <circle r="52" fill="none" stroke="url(#brandGrad)" stroke-width="10" mask="url(#arcCutMask)"/>
      <circle cx="0" cy="-52" r="14.5" fill="#713AED"/>
      <circle cx="49" cy="-17" r="14.5" fill="#2A53EB"/>
      <circle cx="30" cy="43" r="14.5" fill="#2563EB"/>
      <circle cx="-30" cy="43" r="14.5" fill="#5556EC"/>
      <circle cx="-49" cy="-17" r="14.5" fill="#7C3AED"/>
    </g>
    <g id="mark-wire" fill="none" stroke="#B7BFCC" stroke-width="1.2">
      <circle r="52" stroke-width="10" opacity=".5" mask="url(#arcCutMask)"/>
      <circle cx="0" cy="-52" r="14.5"/>
      <circle cx="49" cy="-17" r="14.5"/>
      <circle cx="30" cy="43" r="14.5"/>
      <circle cx="-30" cy="43" r="14.5"/>
      <circle cx="-49" cy="-17" r="14.5"/>
      <circle r="55" opacity=".35"/>
    </g>
    <g id="mark-dark" fill="#07101F" stroke="#07101F">
      <circle r="52" fill="none" stroke-width="10" mask="url(#arcCutMask)"/>
      <circle cx="0" cy="-52" r="14.5"/><circle cx="49" cy="-17" r="14.5"/><circle cx="30" cy="43" r="14.5"/><circle cx="-30" cy="43" r="14.5"/><circle cx="-49" cy="-17" r="14.5"/>
    </g>
    <g id="mark-gray" fill="#AEB3BB" stroke="#AEB3BB">
      <circle r="52" fill="none" stroke-width="10" mask="url(#arcCutMask)"/>
      <circle cx="0" cy="-52" r="14.5"/><circle cx="49" cy="-17" r="14.5"/><circle cx="30" cy="43" r="14.5"/><circle cx="-30" cy="43" r="14.5"/><circle cx="-49" cy="-17" r="14.5"/>
    </g>
    <g id="mark-white" fill="#FFFFFF" stroke="#FFFFFF">
      <circle r="52" fill="none" stroke-width="10" mask="url(#arcCutMask)"/>
      <circle cx="0" cy="-52" r="14.5"/><circle cx="49" cy="-17" r="14.5"/><circle cx="30" cy="43" r="14.5"/><circle cx="-30" cy="43" r="14.5"/><circle cx="-49" cy="-17" r="14.5"/>
    </g>
    <!-- Liberation Sans 2.1.5 Bold; regenerated by scripts/generate_brand_assets.py. -->
    <path id="wordmark-path" d="M1507 711Q1507 491 1420.0 324.0Q1333 157 1171.0 68.5Q1009 -20 793 -20Q461 -20 272.5 175.5Q84 371 84 711Q84 1050 272.0 1240.0Q460 1430 795 1430Q1130 1430 1318.5 1238.0Q1507 1046 1507 711ZM1206 711Q1206 939 1098.0 1068.5Q990 1198 795 1198Q597 1198 489.0 1069.5Q381 941 381 711Q381 479 491.5 345.5Q602 212 793 212Q991 212 1098.5 342.0Q1206 472 1206 711ZM2760 546Q2760 275 2651.5 127.5Q2543 -20 2345 -20Q2231 -20 2146.5 29.5Q2062 79 2017 172H2011Q2017 142 2017 -10V-425H1736V833Q1736 986 1728 1082H2001Q2006 1064 2009.5 1011.0Q2013 958 2013 906H2017Q2112 1105 2363 1105Q2552 1105 2656.0 959.5Q2760 814 2760 546ZM2467 546Q2467 910 2244 910Q2132 910 2072.5 812.0Q2013 714 2013 538Q2013 363 2072.5 267.5Q2132 172 2242 172Q2467 172 2467 546ZM3430 -20Q3186 -20 3055.0 124.5Q2924 269 2924 546Q2924 814 3057.0 958.0Q3190 1102 3434 1102Q3667 1102 3790.0 947.5Q3913 793 3913 495V487H3219Q3219 329 3277.5 248.5Q3336 168 3444 168Q3593 168 3632 297L3897 274Q3782 -20 3430 -20ZM3430 925Q3331 925 3277.5 856.0Q3224 787 3221 663H3641Q3633 794 3578.0 859.5Q3523 925 3430 925ZM4827 0V607Q4827 892 4634 892Q4532 892 4469.5 804.5Q4407 717 4407 580V0H4126V840Q4126 927 4123.5 982.5Q4121 1038 4118 1082H4386Q4389 1063 4394.0 980.5Q4399 898 4399 867H4403Q4460 991 4546.0 1047.0Q4632 1103 4751 1103Q4923 1103 5015.0 997.0Q5107 891 5107 687V0ZM6029 212Q6296 212 6400 480L6657 383Q6574 179 6413.5 79.5Q6253 -20 6029 -20Q5689 -20 5503.5 172.5Q5318 365 5318 711Q5318 1058 5497.0 1244.0Q5676 1430 6016 1430Q6264 1430 6420.0 1330.5Q6576 1231 6639 1038L6379 967Q6346 1073 6249.5 1135.5Q6153 1198 6022 1198Q5822 1198 5718.5 1074.0Q5615 950 5615 711Q5615 468 5721.5 340.0Q5828 212 6029 212ZM7884 542Q7884 279 7738.0 129.5Q7592 -20 7334 -20Q7081 -20 6937.0 130.0Q6793 280 6793 542Q6793 803 6937.0 952.5Q7081 1102 7340 1102Q7605 1102 7744.5 957.5Q7884 813 7884 542ZM7590 542Q7590 735 7527.0 822.0Q7464 909 7344 909Q7088 909 7088 542Q7088 361 7150.5 266.5Q7213 172 7331 172Q7590 172 7590 542ZM8107 0V1484H8388V0ZM8676 0V1484H8957V0ZM9495 -20Q9338 -20 9250.0 65.5Q9162 151 9162 306Q9162 474 9271.5 562.0Q9381 650 9589 652L9822 656V711Q9822 817 9785.0 868.5Q9748 920 9664 920Q9586 920 9549.5 884.5Q9513 849 9504 767L9211 781Q9238 939 9355.5 1020.5Q9473 1102 9676 1102Q9881 1102 9992.0 1001.0Q10103 900 10103 714V320Q10103 229 10123.5 194.5Q10144 160 10192 160Q10224 160 10254 166V14Q10229 8 10209.0 3.0Q10189 -2 10169.0 -5.0Q10149 -8 10126.5 -10.0Q10104 -12 10074 -12Q9968 -12 9917.5 40.0Q9867 92 9857 193H9851Q9733 -20 9495 -20ZM9822 501 9678 499Q9580 495 9539.0 477.5Q9498 460 9476.5 424.0Q9455 388 9455 328Q9455 251 9490.5 213.5Q9526 176 9585 176Q9651 176 9705.5 212.0Q9760 248 9791.0 311.5Q9822 375 9822 446ZM11408 545Q11408 277 11300.5 128.5Q11193 -20 10993 -20Q10878 -20 10794.0 30.0Q10710 80 10665 174H10663Q10663 139 10658.5 78.0Q10654 17 10649 0H10376Q10384 93 10384 247V1484H10665V1070L10661 894H10665Q10760 1102 11011 1102Q11203 1102 11305.5 956.5Q11408 811 11408 545ZM11115 545Q11115 729 11061.0 818.0Q11007 907 10894 907Q10780 907 10720.5 811.5Q10661 716 10661 536Q10661 364 10719.5 268.0Q10778 172 10892 172Q11115 172 11115 545Z"/>
    <style>
      text { font-family:"Liberation Sans",sans-serif; font-kerning:normal; text-rendering:geometricPrecision }
      .label { font-size:13.5px; font-weight:700; letter-spacing:-.35px }
      .body { font-size:12.8px; font-weight:400; letter-spacing:-.08px; fill:#253047 }
      .small { font-size:11.25px; letter-spacing:-.05px; fill:#38445B }
      .micro { font-size:9.75px; fill:#536077 }
      .rule { stroke:#D7DCE5; stroke-width:1 }
      .guide { stroke:#CBD2DE; stroke-width:1; stroke-dasharray:4 4; fill:none }
    </style>
  </defs>

  <rect width="1254" height="1254" fill="#FFFFFF"/>

  <!-- Hero -->
  <g transform="translate(208 164) scale(1.75)"><use href="#mark"/></g>
  <use href="#wordmark-path" transform="translate(374 201) scale(.0673828125 -.0673828125)" fill="#000000"/>
  <text x="374" y="276" font-size="32" font-weight="500" fill="#253047" letter-spacing="-.7">An Operating Theory of Organized Intelligence.</text>
  <line class="rule" x1="47" y1="338" x2="1207" y2="338"/>

  <!-- Row 1 headings -->
  <text class="label" x="48" y="368">PRIMARY MARK</text>
  <text class="label" x="405" y="368">MARK CONSTRUCTION</text>
  <text class="label" x="883" y="368">VISUAL PRINCIPLES</text>
  <line class="rule" x1="369" y1="360" x2="369" y2="616" opacity=".75"/>
  <line class="rule" x1="848" y1="360" x2="848" y2="616" opacity=".75"/>

  <!-- Primary mark -->
  <g transform="translate(192 501) scale(1.5)"><use href="#mark"/></g>

  <!-- Construction -->
  <g transform="translate(498 500) scale(1.25)"><use href="#mark-wire"/></g>
  <path class="guide" d="M407 500H588 M498 409V590" opacity=".22"/>
  <g transform="translate(730 501)">
    <path class="guide" d="M-84 0H84M0-84V84" opacity=".24"/>
    <g transform="scale(1.13)"><use href="#mark"/></g>
  </g>

  <!-- Visual principles -->
  <circle cx="918" cy="428" r="18" fill="none" stroke="url(#brandGrad)" stroke-width="2.5"/>
  <text class="body" x="966" y="416" font-weight="700" fill="#07101F">Organization</text>
  <text class="body" x="966" y="436">Not linear. Not centralized.</text>
  <text class="body" x="966" y="454">A composition of relations.</text>
  <circle cx="918" cy="507" r="18" fill="none" stroke="url(#brandGrad)" stroke-width="2.5"/>
  <text class="body" x="966" y="496" font-weight="700" fill="#07101F">Control</text>
  <text class="body" x="966" y="516">Authority may move.</text>
  <text class="body" x="966" y="534">Organization remains.</text>
  <g transform="translate(918 587) scale(.32)"><use href="#mark"/></g>
  <text class="body" x="966" y="576" font-weight="700" fill="#07101F">Emergence</text>
  <text class="body" x="966" y="596">Intelligence arises from</text>
  <text class="body" x="966" y="614">the whole, not the parts.</text>

  <!-- Row 2 -->
  <line class="rule" x1="47" y1="648" x2="1207" y2="648"/>
  <text class="label" x="48" y="679">COLOR SYSTEM</text>
  <text class="label" x="883" y="679">CLEAR SPACE</text>
  <line class="rule" x1="848" y1="664" x2="848" y2="816" opacity=".75"/>

  <!-- Color supports display recognition; geometry remains valid in monochrome. -->
  <rect x="70" y="734.5" width="379" height="9" rx="4.5" fill="url(#colorBar)"/>
  <text class="small" x="70" y="772">#7C3AED</text><text class="small" x="70" y="790" fill="#07101F">Purple</text>
  <text class="small" x="449" y="772" text-anchor="end">#2563EB</text><text class="small" x="449" y="790" text-anchor="end" fill="#07101F">Research Blue</text>
  <circle cx="544" cy="740" r="19" fill="#7C3AED"/>
  <circle cx="615" cy="740" r="19" fill="#2563EB"/>
  <circle cx="686" cy="740" r="19" fill="#0F172A"/>
  <circle cx="756" cy="740" r="19" fill="#E2E8F0"/>
  <text class="small" x="544" y="790" text-anchor="middle">#7C3AED</text>
  <text class="small" x="615" y="790" text-anchor="middle">#2563EB</text>
  <text class="small" x="686" y="790" text-anchor="middle">#0F172A</text>
  <text class="small" x="756" y="790" text-anchor="middle">#E2E8F0</text>

  <!-- Clear space -->
  <rect x="903" y="707" width="141" height="109" class="guide"/>
  <path class="guide" d="M918 694V824M1029 694V824M891 707H1055M891 816H1055" opacity=".5"/>
  <g transform="translate(974 762) scale(.72)"><use href="#mark"/></g>
  <text class="micro" x="973" y="701">x</text><text class="micro" x="973" y="831">x</text>
  <text class="micro" x="891" y="766">x</text><text class="micro" x="1048" y="766">x</text>
  <text class="small" x="1084" y="736">Clear space</text><text class="small" x="1084" y="755">is defined by</text><text class="small" x="1084" y="774">the diameter</text><text class="small" x="1084" y="793">of one node (x).</text>

  <!-- Row 3 -->
  <line class="rule" x1="47" y1="845" x2="1207" y2="845"/>
  <text class="label" x="48" y="874">SIZE &amp; LEGIBILITY</text>
  <text class="label" x="727" y="874">MONOCHROME</text>
  <line class="rule" x1="692" y1="864" x2="692" y2="1008" opacity=".75"/>

  <g transform="translate(133 929) scale(.62)"><use href="#mark"/></g>
  <text class="small" x="133" y="989" text-anchor="middle">64px+</text><text class="small" x="133" y="1006" text-anchor="middle">Full detail</text>
  <g transform="translate(304 929) scale(.48)"><use href="#mark"/></g>
  <text class="small" x="304" y="989" text-anchor="middle">48px+</text><text class="small" x="304" y="1006" text-anchor="middle">Full detail</text>
  <g transform="translate(452 929) scale(.34)"><use href="#mark"/></g>
  <text class="small" x="452" y="989" text-anchor="middle">32px+</text><text class="small" x="452" y="1006" text-anchor="middle">Simplified arcs</text>
  <g transform="translate(590 929) scale(.27)"><use href="#mark"/></g>
  <text class="small" x="590" y="989" text-anchor="middle">24px+</text><text class="small" x="590" y="1006" text-anchor="middle">Simplified arcs</text>

  <g transform="translate(800 945) scale(.58)"><use href="#mark-dark"/></g>
  <g transform="translate(941 945) scale(.58)"><use href="#mark-gray"/></g>
  <rect x="1040" y="901" width="90" height="90" rx="17" fill="#030712" filter="url(#shadow)"/>
  <g transform="translate(1085 946) scale(.49)"><use href="#mark-white"/></g>

  <!-- Applications -->
  <line class="rule" x1="47" y1="1028" x2="1207" y2="1028"/>
  <text class="label" x="48" y="1058">APPLICATIONS</text>

  <g filter="url(#shadow)">
    <rect x="45" y="1073" width="198" height="99" rx="12" fill="#FFFFFF"/>
    <rect x="283" y="1073" width="164" height="99" rx="12" fill="#FFFFFF"/>
    <rect x="488" y="1073" width="90" height="92" rx="16" fill="#050B19"/>
    <rect x="640" y="1073" width="103" height="92" rx="16" fill="#FFFFFF"/>
    <rect x="785" y="1073" width="198" height="99" rx="12" fill="#050B19"/>
    <rect x="1017" y="1060" width="190" height="117" rx="13" fill="#FFFFFF"/>
  </g>

  <!-- Horizontal lockup -->
  <g transform="translate(78 1124) scale(.34)"><use href="#mark"/></g>
  <use href="#wordmark-path" transform="translate(108 1136) scale(.01171875 -.01171875)" fill="#000000"/>
  <text class="small" x="144" y="1197" text-anchor="middle">Horizontal Lockup</text>

  <!-- Stacked lockup -->
  <g transform="translate(365 1105) scale(.35)"><use href="#mark"/></g>
  <use href="#wordmark-path" transform="translate(308.8867 1157) scale(.009765625 -.009765625)" fill="#000000"/>
  <text class="small" x="365" y="1197" text-anchor="middle">Stacked Lockup</text>

  <!-- App -->
  <g transform="translate(533 1119) scale(.56)"><use href="#mark"/></g>
  <text class="small" x="533" y="1197" text-anchor="middle">App / Favicon</text>

  <!-- Light background -->
  <g transform="translate(692 1119) scale(.56)"><use href="#mark"/></g>
  <text class="small" x="692" y="1197" text-anchor="middle">Light Background</text>

  <!-- Dark background -->
  <g transform="translate(823 1122) scale(.38)"><use href="#mark"/></g>
  <use href="#wordmark-path" transform="translate(852 1135) scale(.01123046875 -.01123046875)" fill="#FFFFFF"/>
  <text class="small" x="884" y="1197" text-anchor="middle">Dark Background</text>

  <!-- Brand element -->
  <text x="1035" y="1094" font-size="13.5" font-weight="650">An Operating Theory of</text>
  <text x="1035" y="1112" font-size="13.5" font-weight="650">Organized Intelligence.</text>
  <line x1="1036" y1="1158" x2="1070" y2="1158" stroke="url(#brandGrad)" stroke-width="2"/>
  <g transform="translate(1180 1148) scale(.28)"><use href="#mark"/></g>
  <text class="small" x="1112" y="1197" text-anchor="middle">Brand Element</text>

  <!-- Footer -->
  <line x1="96" y1="1234" x2="449" y2="1234" stroke="url(#footerBar)" stroke-width="1.2"/>
  <text x="470" y="1239" font-size="17" font-weight="500" fill="url(#footerBar)">An Operating Theory of Organized Intelligence.</text>
  <line x1="839" y1="1234" x2="1138" y2="1234" stroke="url(#footerBar)" stroke-width="1.2"/>
</svg>
